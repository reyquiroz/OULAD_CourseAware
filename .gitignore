# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb

# ── Virtual environments ──────────────────────────────────────────────────
oulad_env/
venv/
env/
ENV/

# ── Raw OULAD data — studentVle.csv is 433 MB, hard-blocked by GitHub ─────
# Only the seven canonical OULAD CSVs belong in data/:
#   assessments.csv, courses.csv, studentAssessment.csv, studentInfo.csv,
#   studentRegistration.csv, studentVle.csv, vle.csv
# Do NOT add unrelated files (e.g. employer exports, training records,
# or any file containing personally identifiable information).
data/studentVle.csv
data/raw/studentVle.csv
data/raw/studentVle.csv.zip
Data/studentVle.csv
DATA/studentVle.csv
# Block future Completion/Report exports (IBM learning platform or similar
# files containing PII that are unrelated to OULAD).
data/*Completion*.csv
data/*Report*.csv
data/raw/*Completion*.csv
data/raw/*Report*.csv

# ── Graph pipeline — large binary artifacts ───────────────────────────────
# Regenerate with: python src/run_graph_pipeline.py --week 8
results/graph/artifacts/*.parquet
results/graph/artifacts/*.csv
# Exception: keep the small metadata JSON (schema + counts, ~4 KB)
!results/graph/artifacts/*_metadata.json

# ── Result files that live in the wrong place ─────────────────────────────
src/*.csv

# ── Old/intermediate output directories ──────────────────────────────────
output_results/
notebooks/output/

# ── Models (regenerate from code) ────────────────────────────────────────
models/*.pkl
models/*.joblib
models/*.h5
models/*.pth

# ── OS files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Temporary files ───────────────────────────────────────────────────────
*.tmp
*.bak
*.log

# ── Test / coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Type checker ─────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Tool-internal (Bob / Speckit — not project content) ──────────────────
.bob/
.specify/
