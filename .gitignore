# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb

# ── Virtual environments ──────────────────────────────────────────────────
oulad_env/
venv/
env/
ENV/

# ── Raw OULAD data (download from https://analyse.kmi.open.ac.uk/open_dataset)
# Covers all directory casings that have appeared in this repo
data/raw/*.csv
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.zip
data/*.csv
data/*.xlsx
data/*.xls
Data/*.csv
Data/*.xlsx
Data/*.xls
DATA/*.csv
DATA/*.xlsx
DATA/*.xls

# ── Graph pipeline — large binary artifacts ───────────────────────────────
# Regenerate with: python src/run_graph_pipeline.py --week 8
results/graph/artifacts/*.parquet
results/graph/artifacts/*.csv
# Exception: keep the small metadata JSON (schema + counts, ~4 KB)
!results/graph/artifacts/*_metadata.json

# ── Result files that live in the wrong place ─────────────────────────────
src/*.csv

# ── Old/intermediate output directories ──────────────────────────────────
output_results/
notebooks/output/

# ── Models (regenerate from code) ────────────────────────────────────────
models/*.pkl
models/*.joblib
models/*.h5
models/*.pth

# ── OS files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Temporary files ───────────────────────────────────────────────────────
*.tmp
*.bak
*.log

# ── Test / coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Type checker ─────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Tool-internal (Bob / Speckit — not project content) ──────────────────
.bob/
.specify/
